import yaml

files = [
    'compat/features.yaml',
    'compat/fields.settings.yaml',
    'compat/fields.entities.yaml',
    'compat/actions.yaml',
    'compat/layouts.yaml'
]

statuses = set()
classifications = set()

for fpath in files:
    with open(fpath, 'r', encoding='utf-8') as f:
        d = yaml.safe_load(f)
    def walk(obj):
        if isinstance(obj, dict):
            if 'status' in obj:
                statuses.add(str(obj['status']))
            if 'classification' in obj:
                classifications.add(str(obj['classification']))
            for v in obj.values():
                walk(v)
        elif isinstance(obj, list):
            for item in obj:
                walk(item)
    walk(d)

print('Statuses found:', statuses)
print('Classifications found:', classifications)
"
