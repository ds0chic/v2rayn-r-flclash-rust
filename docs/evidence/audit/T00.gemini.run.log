import yaml

files = [
    'compat/features.yaml',
    'compat/fields.settings.yaml',
    'compat/fields.entities.yaml',
    'compat/actions.yaml',
    'compat/layouts.yaml'
]

verified_count = 0
na_no_evidence = []
default_verified_no_evidence = []

for fpath in files:
    with open(fpath, 'r', encoding='utf-8') as f:
        d = yaml.safe_load(f)
    def walk(obj, path=''):
        global verified_count
        if isinstance(obj, dict):
            if obj.get('status') == 'verified':
                verified_count += 1
                print('VERIFIED FOUND:', path, obj.get('id'))
            if obj.get('classification') == 'not_applicable' and not obj.get('evidence'):
                na_no_evidence.append((path, obj.get('id')))
            if obj.get('default_verified') is True and not obj.get('evidence'):
                default_verified_no_evidence.append((path, obj.get('id')))
            for k, v in obj.items():
                walk(v, f'{path}.{k}')
        elif isinstance(obj, list):
            for i, item in enumerate(obj):
                walk(item, f'{path}[{i}]')
    walk(d)

print('Total verified items:', verified_count)
print('Total NA without evidence:', len(na_no_evidence))
print('Total default_verified without evidence:', len(default_verified_no_evidence))
