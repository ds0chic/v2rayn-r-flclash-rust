import os, hashlib

with open('fixtures/source/SHA256SUMS', 'r', encoding='utf-8') as f:
    lines = f.readlines()

total = 0
matches = 0
for line in lines:
    line = line.strip()
    if not line or line.startswith('#'):
        continue
    parts = line.split(maxsplit=1)
    if len(parts) == 2:
        total += 1
        expected_hash, relpath = parts[0].lower(), parts[1].strip()
        fpath = os.path.join('fixtures/source/upstream', relpath)
        if os.path.exists(fpath):
            with open(fpath, 'rb') as fp:
                h = hashlib.sha256(fp.read()).hexdigest().lower()
            if h == expected_hash:
                matches += 1
            else:
                print('MISMATCH:', relpath, expected_hash, h)
        else:
            print('FILE NOT FOUND in upstream:', fpath)

print(f'Fixtures checksum with upstream/ prefix: {matches}/{total} match')
"
